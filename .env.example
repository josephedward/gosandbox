# ACloud.Guru / Pluralsight credentials
USERNAME="your-email@example.com"
PASSWORD="your-password"
URL="https://learn.acloud.guru/cloud-playground/cloud-sandboxes"

# Set to any non-empty string to run integration tests that require credentials
INTEGRATION_TESTS="true"

# Optional: acloud guru sandbox selector for a specific sandbox
# For example, to start the Azure sandbox instead of the default AWS one
# ACLOUD_SELECTOR="button:contains('Start Azure Sandbox')"
